<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        父工程说明：
        1. 统一管理多模块版本号
        2. 统一管理 Java / Maven 编译参数
        3. 不承载具体业务代码，因此 packaging 使用 pom
     -->
    <groupId>io.github.forgottenlab.emg</groupId>
    <artifactId>entity-model-generator</artifactId>
    <version>1.2.2</version>
    <packaging>pom</packaging>

    <name>Entity Model Generator</name>
    <description>A Java APT-based compile-time entity model generator.</description>
    <url>https://github.com/forgottenlab/entity-model-generator</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/forgottenlab/entity-model-generator.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/forgottenlab/entity-model-generator.git</developerConnection>
        <url>https://github.com/forgottenlab/entity-model-generator</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 多模块聚合入口 -->
    <modules>
        <module>emg-annotations</module>
        <module>emg-core</module>
        <module>emg-processor</module>
        <module>emg-demo</module>
    </modules>

    <properties>
        <!-- 统一 Java 版本，子模块默认继承 -->
        <java.version>17</java.version>

        <!-- 统一 Maven 编译参数 -->
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- 统一编码，避免源码与构建输出中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 常用插件 / 依赖版本集中管理，便于后续统一升级 -->
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.5</maven.surefire.plugin.version>
        <junit.jupiter.version>5.14.4</junit.jupiter.version>
        <compile.testing.version>0.22.0</compile.testing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                统一管理内部模块版本：
                子模块之间相互依赖时，不必重复显式写 version
             -->
            <dependency>
                <groupId>io.github.forgottenlab.emg</groupId>
                <artifactId>emg-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.forgottenlab.emg</groupId>
                <artifactId>emg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.forgottenlab.emg</groupId>
                <artifactId>emg-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    统一管理编译插件版本与默认配置。
                    子模块需要使用时可直接声明插件而无需重复写版本号。
                 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
