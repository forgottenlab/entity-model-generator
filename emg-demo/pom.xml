<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程统一配置 -->
    <parent>
        <groupId>io.github.forgottenlab.emg</groupId>
        <artifactId>entity-model-generator</artifactId>
        <version>1.2.1</version>
    </parent>

    <artifactId>emg-demo</artifactId>
    <name>EMG Demo</name>
    <description>Demo module for Entity Model Generator.</description>

    <dependencies>
        <!--
            demo 编写实体类时需要直接使用注解，因此依赖 annotations。
         -->
        <dependency>
            <groupId>io.github.forgottenlab.emg</groupId>
            <artifactId>emg-annotations</artifactId>
        </dependency>

        <!--
            demo 若直接使用了 core 中的部分常量、模型或工具类，则保留该依赖。
            如果没有直接使用，也可以后续移除，保持示例最小化。
         -->
        <dependency>
            <groupId>io.github.forgottenlab.emg</groupId>
            <artifactId>emg-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        demo 模块在编译时通过 annotationProcessorPaths 显式引入 emg-processor，
                        这样实体类上的注解才能触发编译期代码生成。
                     -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.forgottenlab.emg</groupId>
                            <artifactId>emg-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>

                    <!--
                        可选配置：
                        如果你后续想显式指定生成源码输出目录，可考虑增加 generatedSourcesDirectory。
                        当前先保持默认行为即可，生成目录通常为：
                        target/generated-sources/annotations
                     -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>