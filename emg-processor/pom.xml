<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程统一配置 -->
    <parent>
        <groupId>io.github.forgottenlab.emg</groupId>
        <artifactId>entity-model-generator</artifactId>
        <version>1.2.2</version>
    </parent>

    <artifactId>emg-processor</artifactId>
    <name>EMG Processor</name>
    <description>Annotation processor for Entity Model Generator.</description>

    <dependencies>
        <!-- 处理器需要识别 EMG 自定义注解 -->
        <dependency>
            <groupId>io.github.forgottenlab.emg</groupId>
            <artifactId>emg-annotations</artifactId>
        </dependency>

        <!-- 处理器复用 core 中的元数据、工具类与常量定义 -->
        <dependency>
            <groupId>io.github.forgottenlab.emg</groupId>
            <artifactId>emg-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.testing.compile</groupId>
            <artifactId>compile-testing</artifactId>
            <version>${compile.testing.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            如果你后续使用 JavaPoet 来生成源码，可以取消下面注释：
            <dependency>
                <groupId>com.squareup</groupId>
                <artifactId>javapoet</artifactId>
                <version>1.13.0</version>
            </dependency>
         -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Processor 使用手写 SPI 注册文件。
                        编译 processor 模块自身时禁用注解处理，避免自处理。
                     -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
